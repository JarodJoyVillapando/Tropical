[
  {
    "name": "theme_info",
    "theme_name": "Tropical",
    "theme_version": "0.1.0",
    "theme_author": "Tropical",
    "theme_documentation_url": "https://github.com/",
    "theme_support_url": "https://github.com/"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_text",
        "label": "Text color",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary color",
        "default": "#a5171f"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background color",
        "default": "#ffffff"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Headings"
      },
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "Heading font",
        "default": "josefin_sans_n4"
      },
      {
        "type": "header",
        "content": "Body"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "roboto_n4"
      }
    ]
  },
  {
    "name": "Animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_animations",
        "label": "Enable scroll animations",
        "default": true
      },
      {
        "type": "select",
        "id": "default_animation_type",
        "label": "Default animation type",
        "options": [
          { "value": "fade-in", "label": "Fade in" },
          { "value": "fade-up", "label": "Fade up" },
          { "value": "fade-down", "label": "Fade down" },
          { "value": "slide-left", "label": "Slide in from right" },
          { "value": "slide-right", "label": "Slide in from left" },
          { "value": "zoom-in", "label": "Zoom in" }
        ],
        "default": "fade-up"
      },
      {
        "type": "range",
        "id": "default_animation_duration",
        "label": "Default animation duration (ms)",
        "min": 200,
        "max": 2000,
        "step": 50,
        "default": 600
      }
    ]
  }
]
