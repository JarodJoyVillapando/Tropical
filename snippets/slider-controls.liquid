<div class="slider__controls">
  <button
    class="slider__button"
    type="button"
    data-slider-prev
    aria-label="{{ 'accessibility.previous' | t }}"
  >
    {% render 'icon-chevron-left' %}
  </button>
  <button
    class="slider__button"
    type="button"
    data-slider-next
    aria-label="{{ 'accessibility.next' | t }}"
  >
    {% render 'icon-chevron-right' %}
  </button>
</div>
