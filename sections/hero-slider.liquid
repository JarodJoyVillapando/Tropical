<section
  class="hero-slider section-spacing"
  aria-label="{{ section.settings.accessibility_label | default: 'Hero' }}"
>
  <div
    class="slider hero-slider__slider"
    data-slider
    data-slides-desktop="1"
    data-slides-mobile="1"
    data-autoplay="{{ section.settings.autoplay }}"
    data-autoplay-interval="{{ section.settings.autoplay_interval | times: 1000 }}"
  >
    <div class="slider__viewport hero-slider__viewport">
      <div
        class="slider__track"
        data-slider-track
      >
        {% for block in section.blocks %}
          <div
            class="slider__slide hero-slider__slide"
            data-slider-slide
            {{ block.shopify_attributes }}
          >
            <div class="hero-slider__slide-inner">
              <div class="hero-slider__media">
                {% render 'hero-slide-background', block: block, eager: forloop.first %}
              </div>
              <div class="hero-slider__overlay"></div>
              <div class="hero-slider__content container">
                {% if block.settings.heading != blank %}
                  <h1 class="hero-slider__heading">
                    {{ block.settings.heading }}
                  </h1>
                {% endif %}
                {% if block.settings.text != blank %}
                  <p class="hero-slider__text">
                    {{ block.settings.text }}
                  </p>
                {% endif %}
                <div class="hero-slider__actions">
                  {% if block.settings.button_label != blank %}
                    <a
                      class="button"
                      href="{{ block.settings.button_link }}"
                    >
                      {{ block.settings.button_label }}
                    </a>
                  {% endif %}
                  {% if block.settings.button_label_2 != blank %}
                    <a
                      class="button button--secondary"
                      href="{{ block.settings.button_link_2 }}"
                    >
                      {{ block.settings.button_label_2 }}
                    </a>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
    {% if section.blocks.size > 1 %}
      {% render 'hero-slider-controls', autoplay: section.settings.autoplay %}
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .hero-slider {
    position: relative;
    margin-top: calc(-1 * var(--header-height, 72px));
    padding-block: 0;
  }

  .hero-slider__slider {
    position: relative;
    height: 100vh;
    min-height: 100vh;
  }

  .hero-slider__viewport {
    height: 100vh;
    min-height: 100vh;
  }

  .hero-slider__slider .slider__track,
  .hero-slider__slide {
    height: 100%;
    min-height: 100vh;
  }

  .hero-slider__slide {
    padding-inline: 0;
  }

  .hero-slider__slide-inner {
    position: relative;
    height: 100%;
    min-height: 100vh;
    overflow: hidden;
  }

  .hero-slider__media {
    position: absolute;
    inset: 0;
  }

  .hero-slider__image,
  .hero-slider__video,
  .hero-slider__embed,
  .hero-slider__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-slider__embed {
    position: relative;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-slider__embed iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 177.78vh;
    min-width: 100%;
    min-height: 56.25vw;
    height: 100vh;
    transform: translate(-50%, -50%);
    border: 0;
  }

  .hero-slider__placeholder {
    background: linear-gradient(135deg, var(--color-text) 0%, var(--color-primary) 100%);
  }

  .hero-slider__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
  }

  .hero-slider__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    height: 100%;
    padding-block: 2rem;
    text-align: left;
    color: var(--color-white);
  }

  .hero-slider__heading {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 5vw, 3.5rem);
    max-width: 48rem;
  }

  .hero-slider__text {
    margin: 0 0 2rem;
    font-size: clamp(1rem, 2vw, 1.25rem);
    max-width: 36rem;
    opacity: 0.9;
  }

  .hero-slider__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: flex-start;
  }

  .hero-slider .slider__controls {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    margin-top: 0;
  }

  .hero-slider .slider__button {
    color: var(--color-white);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .hero-slider .slider__button:hover:not(:disabled) {
    color: var(--color-white);
    background-color: rgba(255, 255, 255, 0.1);
    border-color: var(--color-white);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero slider",
  "tag": "section",
  "class": "hero-slider-section",
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Hero"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Autoplay interval (seconds)",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "select",
          "id": "background_type",
          "label": "Background type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "select",
          "id": "video_source",
          "label": "Video source",
          "options": [
            { "value": "local", "label": "Local file" },
            { "value": "youtube", "label": "YouTube" },
            { "value": "vimeo", "label": "Vimeo" }
          ],
          "default": "youtube"
        },
        {
          "type": "text",
          "id": "video_file",
          "label": "Local video URL",
          "info": "Direct link to an MP4 file"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "YouTube or Vimeo URL"
        },
        {
          "type": "image_picker",
          "id": "video_poster",
          "label": "Video poster image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Welcome to Tropical"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "Second button label"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Second button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slider",
      "blocks": [
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
