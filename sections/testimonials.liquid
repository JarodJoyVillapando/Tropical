<section class="testimonials section-spacing">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="section-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}
    <div
      class="slider testimonials__slider"
      data-slider
      data-slides-desktop="1"
      data-slides-mobile="1"
      data-autoplay="true"
      data-autoplay-interval="8000"
    >
      <div class="slider__viewport">
        <div
          class="slider__track"
          data-slider-track
        >
          {% for block in section.blocks %}
            <div
              class="slider__slide"
              data-slider-slide
              {{ block.shopify_attributes }}
            >
              <blockquote class="testimonials__quote">
                <p class="testimonials__text">
                  "{{ block.settings.quote }}"
                </p>
                {% if block.settings.rating > 0 %}
                  <div
                    class="testimonials__stars"
                    aria-label="{{ block.settings.rating }} out of 5 stars"
                  >
                    {% for i in (1..5) %}
                      <span class="testimonials__star{% if i > block.settings.rating %} testimonials__star--empty{% endif %}">
                        {% render 'icon-star' %}
                      </span>
                    {% endfor %}
                  </div>
                {% endif %}
                {% assign avatar = block.settings.image %}
                {% if avatar.src %}
                  {% assign avatar = avatar.src %}
                {% endif %}
                {% if avatar != blank %}
                  <img
                    class="testimonials__avatar"
                    src="{{ avatar | image_url: width: 160 }}"
                    alt="{{ block.settings.name | escape }}"
                    width="80"
                    height="80"
                    loading="lazy"
                  >
                {% endif %}
                {% if block.settings.name != blank %}
                  <cite class="testimonials__name">
                    {{ block.settings.name }}
                  </cite>
                {% endif %}
              </blockquote>
            </div>
          {% endfor %}
        </div>
      </div>
      {% if section.blocks.size > 1 %}
        {% render 'slider-controls' %}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .testimonials__quote {
    margin: 0;
    text-align: center;
  }

  .testimonials__text {
    margin: 0 auto 1.5rem;
    font-family: var(--font-heading-family);
    font-size: clamp(1.25rem, 3vw, 2rem);
    line-height: 1.4;
    max-width: 48rem;
    text-transform: none;
  }

  .testimonials__stars {
    display: flex;
    justify-content: center;
    gap: 0.25rem;
    margin-bottom: 1.5rem;
  }

  .testimonials__star {
    color: var(--color-primary);
  }

  .testimonials__star .icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  .testimonials__star--empty {
    opacity: 0.25;
  }

  .testimonials__avatar {
    display: block;
    width: 5rem;
    height: 5rem;
    margin: 0 auto 1rem;
    object-fit: cover;
    border-radius: 50%;
  }

  .testimonials__name {
    display: block;
    font-family: var(--font-body-family);
    font-size: 1rem;
    font-style: normal;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "testimonials-section section-spacing",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Students Say"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
