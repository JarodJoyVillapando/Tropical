<section
  class="collection-products section-spacing {% render 'motion', mode: 'class', type: section.settings.animation_type, duration: section.settings.animation_duration %}"
  style="{% render 'motion', mode: 'style', type: section.settings.animation_type, duration: section.settings.animation_duration %}"
  {% render 'motion', mode: 'data', type: section.settings.animation_type, duration: section.settings.animation_duration %}
>
  <div class="container">
    {% if section.settings.heading != blank %}
      {% assign heading = section.settings.heading %}
    {% else %}
      {% assign heading = collection.title %}
    {% endif %}

    {% if heading != blank %}
      <h1 class="collection-products__heading section-heading">
        {{ heading }}
      </h1>
    {% endif %}

    {% if section.settings.show_description and collection.description != blank %}
      <div class="collection-products__description">
        {{ collection.description }}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="collection-products__groups">
        {% for block in section.blocks %}
          {% if block.type == 'level' %}
            {% render 'collection-product-group',
              collection: collection,
              heading: block.settings.heading,
              tag: block.settings.tag,
              block_attributes: block.shopify_attributes,
              group_animation_type: block.settings.animation_type,
              group_animation_duration: block.settings.animation_duration,
              item_animation_type: section.settings.item_animation_type,
              item_animation_duration: section.settings.item_animation_duration
            %}
          {% endif %}
        {% endfor %}
      </div>
    {% elsif collection.products.size > 0 %}
      <div class="collection-products__grid">
        {% for product in collection.products %}
          <div
            class="collection-products__grid-item {% render 'motion', mode: 'class', type: section.settings.item_animation_type, duration: section.settings.item_animation_duration %}"
            style="{% render 'motion', mode: 'style', type: section.settings.item_animation_type, duration: section.settings.item_animation_duration %} --motion-stagger-index: {{ forloop.index0 }};"
            {% render 'motion', mode: 'data', type: section.settings.item_animation_type, duration: section.settings.item_animation_duration %}
          >
            {% render 'card-product', product: product %}
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p class="collection-products__empty">
        {{ 'sections.collection_products.empty' | t }}
      </p>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .collection-products__heading {
    margin-bottom: 1rem;
    text-align: center;
  }

  .collection-products__description {
    max-width: 48rem;
    margin: 0 auto 3rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    text-align: center;
  }

  .collection-products__groups {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .collection-products__group-heading {
    margin: 0 0 1.5rem;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    text-align: center;
  }

  .collection-products__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .collection-products__grid-item {
    min-width: 0;
  }

  .collection-products__empty {
    margin: 0;
    text-align: center;
    color: rgba(0, 0, 0, 0.7);
  }

  @media (min-width: 768px) {
    .collection-products__grid {
      gap: 1.5rem;
    }

    .collection-products__groups {
      gap: 4rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection products",
  "tag": "section",
  "class": "collection-products-section section-spacing",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the collection title."
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "header",
      "content": "Section animation"
    },
    {
      "type": "select",
      "id": "animation_type",
      "label": "Animation type",
      "options": [
        { "value": "theme_default", "label": "Theme default" },
        { "value": "none", "label": "None" },
        { "value": "fade-in", "label": "Fade in" },
        { "value": "fade-up", "label": "Fade up" },
        { "value": "fade-down", "label": "Fade down" },
        { "value": "slide-left", "label": "Slide in from right" },
        { "value": "slide-right", "label": "Slide in from left" },
        { "value": "zoom-in", "label": "Zoom in" }
      ],
      "default": "theme_default"
    },
    {
      "type": "range",
      "id": "animation_duration",
      "label": "Animation duration (ms)",
      "min": 0,
      "max": 2000,
      "step": 50,
      "default": 0,
      "info": "0 uses the theme default duration."
    },
    {
      "type": "header",
      "content": "Product card animation"
    },
    {
      "type": "select",
      "id": "item_animation_type",
      "label": "Animation type",
      "options": [
        { "value": "theme_default", "label": "Theme default" },
        { "value": "none", "label": "None" },
        { "value": "fade-in", "label": "Fade in" },
        { "value": "fade-up", "label": "Fade up" },
        { "value": "fade-down", "label": "Fade down" },
        { "value": "slide-left", "label": "Slide in from right" },
        { "value": "slide-right", "label": "Slide in from left" },
        { "value": "zoom-in", "label": "Zoom in" }
      ],
      "default": "theme_default"
    },
    {
      "type": "range",
      "id": "item_animation_duration",
      "label": "Animation duration (ms)",
      "min": 0,
      "max": 2000,
      "step": 50,
      "default": 0,
      "info": "0 uses the theme default duration."
    }
  ],
  "blocks": [
    {
      "type": "level",
      "name": "Skill level",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Beginner"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Product tag",
          "info": "Products in this collection with this tag are listed in this group.",
          "default": "beginner"
        },
        {
          "type": "header",
          "content": "Animation"
        },
        {
          "type": "select",
          "id": "animation_type",
          "label": "Animation type",
          "options": [
            { "value": "theme_default", "label": "Theme default" },
            { "value": "none", "label": "None" },
            { "value": "fade-in", "label": "Fade in" },
            { "value": "fade-up", "label": "Fade up" },
            { "value": "fade-down", "label": "Fade down" },
            { "value": "slide-left", "label": "Slide in from right" },
            { "value": "slide-right", "label": "Slide in from left" },
            { "value": "zoom-in", "label": "Zoom in" }
          ],
          "default": "theme_default"
        },
        {
          "type": "range",
          "id": "animation_duration",
          "label": "Animation duration (ms)",
          "min": 0,
          "max": 2000,
          "step": 50,
          "default": 0,
          "info": "0 uses the theme default duration."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection products",
      "blocks": [
        {
          "type": "level",
          "settings": {
            "heading": "Beginner",
            "tag": "beginner"
          }
        },
        {
          "type": "level",
          "settings": {
            "heading": "Intermediate",
            "tag": "intermediate"
          }
        },
        {
          "type": "level",
          "settings": {
            "heading": "Advanced",
            "tag": "advanced"
          }
        }
      ]
    }
  ]
}
{% endschema %}
