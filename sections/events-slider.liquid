<section class="events-slider section-spacing">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="section-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}
    <div
      class="slider slider--cards"
      data-slider
      data-slides-desktop="4"
      data-slides-mobile="1"
    >
      <div class="slider__viewport">
        <div
          class="slider__track"
          data-slider-track
        >
          {% for block in section.blocks %}
            <div
              class="slider__slide"
              data-slider-slide
              {{ block.shopify_attributes }}
            >
              <div class="slider__slide-inner">
                {% render 'card-event',
                  title: block.settings.title,
                  image: block.settings.image,
                  location: block.settings.location,
                  date: block.settings.date,
                  time: block.settings.time,
                  description: block.settings.description,
                  url: block.settings.url
                %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
      {% render 'slider-controls' %}
    </div>
  </div>
</section>

{% stylesheet %}
  .events-slider {
    color: var(--color-white);
    background-color: var(--color-text);
  }

  .events-slider .section-heading {
    color: var(--color-white);
  }

  .events-slider .card--event .card__hover-bg {
    background-color: var(--color-primary);
  }

  .events-slider .slider__button {
    color: var(--color-white);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .events-slider .slider__button:hover:not(:disabled) {
    color: var(--color-white);
    border-color: var(--color-white);
    background-color: rgba(255, 255, 255, 0.08);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Events slider",
  "tag": "section",
  "class": "events-slider-section section-spacing",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Upcoming Events"
    }
  ],
  "blocks": [
    {
      "type": "event",
      "name": "Event",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date"
        },
        {
          "type": "text",
          "id": "time",
          "label": "Time"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Events slider",
      "blocks": [
        { "type": "event" },
        { "type": "event" },
        { "type": "event" },
        { "type": "event" }
      ]
    }
  ]
}
{% endschema %}
