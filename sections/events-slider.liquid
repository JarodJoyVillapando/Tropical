<section
  class="events-slider section-spacing {% render 'motion', mode: 'class', type: section.settings.animation_type, duration: section.settings.animation_duration %}"
  style="{% render 'motion', mode: 'style', type: section.settings.animation_type, duration: section.settings.animation_duration %}"
  {% render 'motion', mode: 'data', type: section.settings.animation_type, duration: section.settings.animation_duration %}
>
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="section-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}
    <div
      class="slider slider--cards"
      data-slider
      data-slides-desktop="4"
      data-slides-mobile="1"
    >
      <div class="slider__viewport">
        <div
          class="slider__track"
          data-slider-track
        >
          {% for block in section.blocks %}
            <div
              class="slider__slide"
              data-slider-slide
              {{ block.shopify_attributes }}
            >
              <div
                class="slider__slide-inner {% render 'motion', mode: 'class', type: block.settings.animation_type, duration: block.settings.animation_duration %}"
                style="{% render 'motion', mode: 'style', type: block.settings.animation_type, duration: block.settings.animation_duration %} --motion-stagger-index: {{ forloop.index0 }};"
                {% render 'motion', mode: 'data', type: block.settings.animation_type, duration: block.settings.animation_duration %}
              >
                {% render 'card-event',
                  title: block.settings.title,
                  image: block.settings.image,
                  location: block.settings.location,
                  date: block.settings.date,
                  time: block.settings.time,
                  description: block.settings.description,
                  url: block.settings.url
                %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
      {% render 'slider-controls' %}
    </div>
  </div>
</section>

{% stylesheet %}
  .events-slider {
    color: var(--color-white);
    background-color: var(--color-text);
  }

  .events-slider .section-heading {
    color: var(--color-white);
  }

  .events-slider .card--event .card__hover-bg {
    background-color: var(--color-primary);
  }

  .events-slider .slider__button {
    color: var(--color-white);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .events-slider .slider__button:hover:not(:disabled) {
    color: var(--color-white);
    border-color: var(--color-white);
    background-color: rgba(255, 255, 255, 0.08);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Events slider",
  "tag": "section",
  "class": "events-slider-section section-spacing",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Upcoming Events"
    },
    {
      "type": "header",
      "content": "Section animation"
    },
    {
      "type": "select",
      "id": "animation_type",
      "label": "Animation type",
      "options": [
        { "value": "theme_default", "label": "Theme default" },
        { "value": "none", "label": "None" },
        { "value": "fade-in", "label": "Fade in" },
        { "value": "fade-up", "label": "Fade up" },
        { "value": "fade-down", "label": "Fade down" },
        { "value": "slide-left", "label": "Slide in from right" },
        { "value": "slide-right", "label": "Slide in from left" },
        { "value": "zoom-in", "label": "Zoom in" }
      ],
      "default": "theme_default"
    },
    {
      "type": "range",
      "id": "animation_duration",
      "label": "Animation duration (ms)",
      "min": 0,
      "max": 2000,
      "step": 50,
      "default": 0,
      "info": "0 uses the theme default duration."
    }
  ],
  "blocks": [
    {
      "type": "event",
      "name": "Event",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date"
        },
        {
          "type": "text",
          "id": "time",
          "label": "Time"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Animation"
        },
        {
          "type": "select",
          "id": "animation_type",
          "label": "Animation type",
          "options": [
            { "value": "theme_default", "label": "Theme default" },
            { "value": "none", "label": "None" },
            { "value": "fade-in", "label": "Fade in" },
            { "value": "fade-up", "label": "Fade up" },
            { "value": "fade-down", "label": "Fade down" },
            { "value": "slide-left", "label": "Slide in from right" },
            { "value": "slide-right", "label": "Slide in from left" },
            { "value": "zoom-in", "label": "Zoom in" }
          ],
          "default": "theme_default"
        },
        {
          "type": "range",
          "id": "animation_duration",
          "label": "Animation duration (ms)",
          "min": 0,
          "max": 2000,
          "step": 50,
          "default": 0,
          "info": "0 uses the theme default duration."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Events slider",
      "blocks": [
        { "type": "event" },
        { "type": "event" },
        { "type": "event" },
        { "type": "event" }
      ]
    }
  ]
}
{% endschema %}
